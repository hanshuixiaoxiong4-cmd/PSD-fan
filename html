<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PerthSantaDomiia 之家</title>
<style>
  :root {
    --accent: #ff8fab; --soft: #ffe0ea; --text: #7a4a5a; --muted: #b08a9a; --gold: #f4b860;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    display: flex; justify-content: center; min-height: 100vh;
    padding: 12px; background: linear-gradient(135deg, #fef6f0, #fce8ef);
    color: var(--text); transition: background .4s;
  }
  .app { width: min(600px, 100%); margin: auto; }
  .screen { display: none; }
  .screen.active { display: block; animation: fadeIn .25s ease; }
  @keyframes fadeIn { from { opacity:0; transform:translateY(6px);} to { opacity:1; transform:none; } }

  /* 顶部栏 */
  .top-bar {
    display: flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,.85); backdrop-filter: blur(10px);
    border-radius: 20px; padding: 10px 14px; margin-bottom: 14px;
    border: 2px solid rgba(255,255,255,.9);
    box-shadow: 0 8px 24px rgba(180,140,160,.18);
  }
  .coin-box { display: flex; align-items: center; gap: 5px; font-weight: 800; font-size: 15px; color: var(--gold); }
  .coin-box .icon { font-size: 18px; }
  .mood-mini { display: flex; gap: 8px; flex: 1; justify-content: center; }
  .mood-dot { display: flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 700; color: var(--muted); }
  .mood-dot .m { font-size: 16px; }
  .top-actions { display: flex; gap: 6px; }
  .icon-btn {
    font-size: 18px; background: #fff; border: 2px solid var(--soft);
    border-radius: 12px; width: 38px; height: 38px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: transform .12s;
  }
  .icon-btn:active { transform: scale(.9); }

  /* 世界地图 */
  .map-title { text-align: center; font-size: 18px; font-weight: 800; margin-bottom: 4px; }
  .map-sub { text-align: center; font-size: 11.5px; color: var(--muted); margin-bottom: 16px; }
  .map-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .room-card {
    position: relative; aspect-ratio: 1.15; border-radius: 24px;
    background: #fff; border: 2px solid var(--soft); cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; transition: transform .15s, box-shadow .15s; overflow: hidden; padding: 12px;
  }
  .room-card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(255,180,200,.4); }
  .room-card:active { transform: scale(.97); }
  .room-icon { font-size: clamp(38px, 10vw, 54px); line-height: 1; }
  .room-name { font-size: 15px; font-weight: 800; }
  .room-desc { font-size: 10.5px; color: var(--muted); text-align: center; }
  .room-badge {
    position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 800;
    background: var(--gold); color: #fff; border-radius: 8px; padding: 2px 7px;
  }
  .family-strip {
    display: flex; justify-content: center; gap: clamp(12px, 6vw, 28px);
    background: rgba(255,255,255,.7); border-radius: 20px; padding: 14px 10px;
    border: 2px solid rgba(255,255,255,.9);
  }
  .fam-mini { display: flex; flex-direction: column; align-items: center; gap: 3px; cursor: pointer; }
  .fam-mini .face { font-size: 30px; }
  .fam-mini .name { font-size: 10px; font-weight: 700; color: var(--muted); }
  .fam-mini .mood-bar { width: 44px; height: 6px; background: #f0e0e8; border-radius: 4px; overflow: hidden; }
  .fam-mini .mood-fill { height: 100%; background: var(--accent); border-radius: 4px; transition: width .3s; }

  /* 房间 */
  .room-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .back-btn {
    font-family: inherit; font-size: 13px; font-weight: 700; color: var(--text);
    background: #fff; border: 2px solid var(--soft); border-radius: 14px;
    padding: 8px 14px; cursor: pointer; white-space: nowrap;
  }
  .back-btn:active { transform: scale(.95); }
  .room-header h2 { flex: 1; font-size: 16px; font-weight: 800; text-align: center; }
  .room-stage {
    position: relative; border-radius: 26px; padding: 24px 16px 20px;
    min-height: 380px; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 18px;
    border: 2px solid rgba(255,255,255,.9);
    box-shadow: inset 0 0 40px rgba(255,255,255,.4);
  }
  .room-stage .scene-bg { position: absolute; inset: 0; border-radius: 26px; z-index: 0; opacity: .9; }
  .room-stage > * { position: relative; z-index: 1; }
  .char-line { display: flex; justify-content: center; gap: clamp(18px, 8vw, 40px); }
  .big-fam { display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; position: relative; transition: transform .15s; }
  .big-fam:active { transform: scale(.92); }
  .big-fam .acc { position: absolute; top: -18px; font-size: 18px; }
  .big-fam .face {
    width: 66px; height: 66px; border-radius: 50%; background: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 36px;
    box-shadow: 0 8px 20px rgba(0,0,0,.12); border: 3px solid #fff; overflow: hidden;
  }
  .big-fam .face img { width: 100%; height: 100%; object-fit: cover; }
  .big-fam .name { font-size: 11px; font-weight: 800; background: rgba(255,255,255,.85); padding: 1px 9px; border-radius: 8px; }
  .big-fam .mood-tag { font-size: 9px; font-weight: 700; color: var(--muted); }
  .speech-box {
    min-height: 36px; font-size: 13px; font-weight: 600; text-align: center;
    background: rgba(255,255,255,.9); border-radius: 16px; padding: 9px 16px;
    max-width: 92%; box-shadow: 0 4px 14px rgba(0,0,0,.08);
    opacity: 0; transition: opacity .2s;
  }
  .speech-box.show { opacity: 1; }

  /* 游戏室卡片 */
  .room-games { width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 10px; }
  .room-game-card {
    display: flex; align-items: center; gap: 12px; text-align: left;
    font-family: inherit; color: var(--text);
    background: #fff; border: 2px solid var(--soft); border-radius: 18px;
    padding: 12px 14px; cursor: pointer; transition: transform .15s, box-shadow .15s;
  }
  .room-game-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(255,180,200,.4); }
  .room-game-card:active { transform: scale(.97); }
  .rg-icon { font-size: 26px; }
  .rg-body { flex: 1; min-width: 0; }
  .rg-title { font-size: 14px; font-weight: 800; }
  .rg-desc { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .rg-arrow { font-size: 18px; color: var(--muted); }

  /* 游戏界面 */
  .game-top { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  #gameTitle { flex: 1; text-align: center; font-size: 14px; font-weight: 800; }
  #gameScore { min-width: 58px; text-align: center; font-size: 14px; font-weight: 800; color: var(--accent); background: #fff; border-radius: 14px; padding: 8px; border: 2px solid var(--soft); }
  .game-info { text-align: center; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 12px; min-height: 16px; }
  #gameArea { display: flex; flex-direction: column; align-items: center; }
  .game-bottom { text-align: center; margin-top: 16px; }
  .btn { font-family: inherit; font-size: 14px; font-weight: 700; border-radius: 30px; padding: 10px 26px; cursor: pointer; border: 2px solid var(--soft); background: #fff; color: var(--text); }
  .btn.primary { background: linear-gradient(135deg, var(--accent), #ff6b9d); color: #fff; border: none; box-shadow: 0 6px 18px rgba(255,120,160,.4); }
  .btn:active { transform: scale(.95); }

  .m3-grid { display: grid; grid-template-columns: repeat(6,1fr); gap: 4px; width: 100%; max-width: 370px; background: #fff8fb; padding: 7px; border-radius: 18px; }
  .m3-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 10px; cursor: pointer; border: 2px solid transparent; font-size: clamp(16px,5.4vw,26px); }
  .m3-cell.sel { border-color: var(--accent); background: var(--soft); }
  .whack-board { display: grid; grid-template-columns: repeat(3,1fr); gap: 9px; width: 100%; max-width: 360px; }
  .whack-hole { aspect-ratio: 1; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: clamp(26px,8vw,40px); cursor: pointer; background: var(--soft); border: 3px solid transparent; }
  .whack-hole.on { background: #fff; border-color: var(--accent); }
  .mem-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 7px; width: 100%; max-width: 340px; }
  .mem-card { aspect-ratio: 3/4; border-radius: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: clamp(18px,6vw,28px); background: linear-gradient(160deg,var(--soft),#ffc8dc); border: 2px solid #fff; }
  .mem-card.flip, .mem-card.matched { background: #fff; }
  .mem-card.matched { opacity: .4; transform: scale(.93); }
  .tile-img { width: 80%; height: 80%; object-fit: contain; }

  /* 弹窗 */
  .mask { position: fixed; inset: 0; background: rgba(60,30,45,.45); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 20px; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .mask.show { opacity: 1; pointer-events: auto; }
  .modal { width: min(420px,100%); background: #fff; border-radius: 24px; padding: 22px; max-height: 88vh; overflow-y: auto; }
  .modal h3 { font-size: 17px; text-align: center; margin-bottom: 12px; }
  .modal-body { font-size: 13.5px; line-height: 1.7; }
  .modal-foot { display: flex; gap: 10px; justify-content: center; margin-top: 16px; flex-wrap: wrap; }
  .field { margin-bottom: 12px; }
  .field label { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
  .field input { width: 100%; font-family: inherit; font-size: 14px; padding: 9px 13px; border-radius: 12px; border: 2px solid var(--soft); outline: none; }
  .opt-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .opt-label { font-size: 12px; font-weight: 700; color: var(--muted); min-width: 50px; }
  .opt { width: 36px; height: 36px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 18px; background: #fff; border: 2px solid var(--soft); }
  .opt.on { border-color: var(--accent); background: var(--soft); }
  .opt.locked { opacity: .4; cursor: not-allowed; }

  /* 关卡选择 */
  .lv-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .lv-btn {
    aspect-ratio: 1; border-radius: 14px; border: 2px solid var(--soft);
    background: #fff; font-family: inherit; cursor: pointer; color: var(--text);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1px; transition: transform .12s, border-color .15s, box-shadow .15s;
  }
  .lv-btn:hover:not(.locked) { border-color: var(--accent); box-shadow: 0 4px 12px rgba(255,143,171,.35); }
  .lv-btn:active:not(.locked) { transform: scale(.92); }
  .lv-btn .lv-num { font-size: 15px; font-weight: 800; }
  .lv-btn .lv-meta { font-size: 9px; color: var(--muted); font-weight: 700; }
  .lv-btn.locked { opacity: .35; cursor: not-allowed; background: #f7eef2; }
  .lv-btn.cleared { background: #f0fbf2; border-color: #bde5c6; }
  .lv-btn.cleared .lv-num { color: #3f7a4c; }
  .lv-btn.cleared::after { content: '✓'; font-size: 9px; color: #3f7a4c; font-weight: 800; }

  /* 教程 */
  #tutMask { position: fixed; inset: 0; z-index: 900; display: none; }
  #tutMask.show { display: block; }
  #tutHole { position: fixed; border-radius: 20px; pointer-events: none; box-shadow: 0 0 0 9999px rgba(45,22,38,.62); transition: all .28s; z-index: 901; }
  .tut-box { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); width: min(420px,calc(100% - 32px)); background: #fff; border-radius: 22px; padding: 18px 20px; z-index: 902; box-shadow: 0 20px 50px rgba(0,0,0,.3); }
  #tutText { font-size: 14px; font-weight: 600; line-height: 1.65; margin-bottom: 14px; }
  .tut-actions { display: flex; gap: 10px; justify-content: flex-end; }
</style>
</head>
<body>
<div class="app">
<!-- 世界地图 -->
  <section id="screen-world" class="screen active">
    <div class="top-bar">
      <div class="coin-box"><span class="icon">🪙</span><span id="coinDisplay">0</span></div>
      <div class="mood-mini" id="moodMini"></div>
      <div class="top-actions">
        <button class="icon-btn" id="btnRename" title="取名字">✏️</button>
        <button class="icon-btn" id="btnDress" title="装扮">🎀</button>
        <button class="icon-btn" id="btnTut" title="教程">❓</button>
      </div>
    </div>
    <div class="map-title" id="mapTitle">PerthSantaDomiia 之家</div>
    <div class="map-sub">点一点房间，进去看看吧～</div>
    <div class="map-grid" id="mapGrid"></div>
    <div class="family-strip" id="familyStrip"></div>
  </section>

  <!-- 房间 -->
  <section id="screen-room" class="screen">
    <div class="room-header">
      <button class="back-btn" id="btnBackMap">← 地图</button>
      <h2 id="roomTitle">客厅</h2>
      <div style="width:70px;"></div>
    </div>
    <div class="room-stage" id="roomStage"></div>
  </section>

  <!-- 游戏 -->
  <section id="screen-game" class="screen">
    <div class="game-top">
      <button class="back-btn" id="btnBackRoom">← 返回</button>
      <div id="gameTitle">游戏</div>
      <div id="gameScore">0</div>
    </div>
    <div class="game-info" id="gameInfo"></div>
    <div id="gameArea"></div>
    <div class="game-bottom" id="gameBottom"></div>
  </section>

</div>

<div class="mask" id="mask"><div class="modal"><h3 id="modalTitle"></h3><div class="modal-body" id="modalBody"></div><div class="modal-foot" id="modalFoot"></div></div></div>
<div id="tutMask"><div id="tutHole"></div><div class="tut-box"><div id="tutText"></div><div class="tut-actions"><button class="btn" id="tutSkip">跳过</button><button class="btn primary" id="tutNext">下一步</button></div></div></div>

<script>
/* ============================================================================
   ★★★ 开发者配置区（玩家无法修改） ★★★
   小游戏图片 / 头像只在这里更换，玩家界面没有任何修改入口。
   ============================================================================ */
const TOTAL_LEVELS = 15;

const DEV_CONFIG = {
  characters: {
    perth:  { key:'perth',  name:'Perth',  emoji:'😎', color:'#7EB8DA' },
    santa:  { key:'santa',  name:'Santa',  emoji:'🤠', color:'#F4A460' },
    domiia: { key:'domiia', name:'Domiia', emoji:'👶', color:'#FFB7C5' }
  },

  rooms: [
    { id:'living',  icon:'🏠', name:'客厅',   desc:'聊聊天，看看电视',    bg:'linear-gradient(180deg,#fdf6ff,#fff0f5 60%,#f5e6d3 60%)' },
    { id:'bedroom', icon:'🛏️', name:'卧室',   desc:'休息一下',            bg:'linear-gradient(180deg,#eef4ff,#e0e8ff 60%,#d8e0f0 60%)' },
    { id:'kitchen', icon:'🍳', name:'厨房',   desc:'做点好吃的',          bg:'linear-gradient(180deg,#fff8ee,#ffeedd 60%,#f0e0cc 60%)' },
    { id:'game',    icon:'🎮', name:'游戏室', desc:'三个小游戏 · 各 15 关', bg:'linear-gradient(180deg,#f3f0ff,#ebe0ff 60%,#e0d4f0 60%)' }
  ],

  match3: {
    tiles: [
      { id:'perth',  emoji:'😎' },          // ← 可换成 { id:'perth', img:'图片地址' }
      { id:'santa',  emoji:'🤠' },
      { id:'domiia', emoji:'👶' },
      { id:'gift',   emoji:'🎁' },
      { id:'bear',   emoji:'🧸' },
      { id:'coffee', emoji:'☕' }
    ],
    /* 15 关：目标分递增、时间递减 */
    levels: Array.from({ length: TOTAL_LEVELS }, function (_, i) {
      const lv = i + 1;
      return {
        duration: Math.max(45, 62 - Math.floor((lv - 1) * 1.2)),  // 62 → 45 秒
        target:   250 + lv * 30,                                  // 280 → 700 分
        reward:   8 + lv * 3                                      // 11 → 53 金币
      };
    })
  },

  whack: {
    good: [ { emoji:'🎬', score:10 }, { emoji:'🌟', score:15 }, { emoji:'📜', score:10 } ],
    bad:  [ { emoji:'😡', score:-8 }, { emoji:'📸', score:-5 } ],
    /* 15 关：出怪变快、目标变高、坏目标概率略升 */
    levels: Array.from({ length: TOTAL_LEVELS }, function (_, i) {
      const lv = i + 1;
      return {
        duration: 30,
        target:   100 + lv * 12,                                // 112 → 280 分
        interval: Math.max(260, 500 - lv * 15),                 // 485 → 275 毫秒
        badRate:  Math.min(0.4, 0.2 + lv * 0.012),              // 21% → 38%
        reward:   8 + lv * 3
      };
    })
  },

  memory: {
    back: { emoji:'❓' },
    cards: [ {emoji:'☕'},{emoji:'🧁'},{emoji:'🍰'},{emoji:'🥐'},{emoji:'🥤'},{emoji:'🍪'},{emoji:'🍩'},{emoji:'🍬'} ],
    /* 15 关：4 对 → 8 对，时间递减 */
    levels: Array.from({ length: TOTAL_LEVELS }, function (_, i) {
      const lv = i + 1;
      return {
        pairs:    Math.min(8, 4 + Math.floor((lv - 1) / 3)),    // 4 → 8 对
        duration: Math.max(40, 70 - (lv - 1) * 2),              // 70 → 42 秒
        reward:   8 + lv * 3
      };
    })
  },

  shop: {
    accessories: [
      { id:'',      emoji:'🚫', price:0 },  { id:'bow',    emoji:'🎀', price:20 },
      { id:'crown', emoji:'👑', price:35 }, { id:'hat',    emoji:'🎩', price:30 },
      { id:'flower',emoji:'🌸', price:15 }, { id:'star',   emoji:'⭐', price:25 }
    ],
    themes: [
      { id:'pink',  name:'温馨粉', bg:'linear-gradient(135deg,#fef6f0,#fce8ef)', accent:'#ff8fab', soft:'#ffe0ea', text:'#7a4a5a', price:0 },
      { id:'blue',  name:'清新蓝', bg:'linear-gradient(135deg,#eef7ff,#e0eeff)', accent:'#6f9fe0', soft:'#dceafd', text:'#3f5f88', price:40 },
      { id:'green', name:'奶油绿', bg:'linear-gradient(135deg,#f3fbf2,#e2f5e4)', accent:'#74bb82', soft:'#dcf0e0', text:'#3f6b4c', price:40 }
    ]
  }
};
/* ★★★ 配置区结束 ★★★ */

const GAMES = [
  { id:'match3', icon:'🎁', title:'开心消消乐' },
  { id:'whack',  icon:'🎬', title:'片场大作战' },
  { id:'memory', icon:'☕', title:'记忆配对' }
];

const STORE = 'psd_home_v2';
const $ = function (id) { return document.getElementById(id); };

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function shuffle(a) {
  const r = a.slice();
  for (let i = r.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = r[i]; r[i] = r[j]; r[j] = t;
  }
  return r;
}
function clearEl(el) { while (el.firstChild) el.removeChild(el.firstChild); }
function makeIcon(spec, cls) {
  if (spec && spec.img) {
    const i = document.createElement('img');
    i.src = spec.img; i.className = cls || 'tile-img'; i.draggable = false;
    return i;
  }
  return document.createTextNode(spec && spec.emoji ? spec.emoji : '');
}
  
/* ---------------- 存档 ---------------- */
function defaultState() {
  return {
    names: { perth:'Perth', santa:'Santa', domiia:'Domiia' },
    coins: 0,
    mood: { perth:80, santa:80, domiia:80 },
    acc: { perth:'', santa:'', domiia:'' },
    theme: 'pink',
    ownedAcc: [''], ownedThemes: ['pink'],
    level: { match3:1, whack:1, memory:1 },
    best: { match3:0, whack:0, memory:0 },
    tutorialDone: false
  };
}
let state = defaultState();

function load() {
  try {
    const raw = localStorage.getItem(STORE);
    if (!raw) return;
    const s = JSON.parse(raw);
    if (!s) return;
    const base = defaultState();
    state = Object.assign(base, s);
    state.names = Object.assign(base.names, s.names || {});
    state.mood  = Object.assign(base.mood,  s.mood  || {});
    state.acc   = Object.assign(base.acc,   s.acc   || {});
    state.level = Object.assign(base.level, s.level || {});
    state.best  = Object.assign(base.best,  s.best  || {});
    state.ownedAcc = s.ownedAcc || [''];
    state.ownedThemes = s.ownedThemes || ['pink'];
  } catch (e) {}
}
function save() { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch (e) {} }

/* ---------------- 主题 & 金币 ---------------- */
function applyTheme() {
  const t = DEV_CONFIG.shop.themes.find(function (x) { return x.id === state.theme; }) || DEV_CONFIG.shop.themes[0];
  document.documentElement.style.setProperty('--accent', t.accent);
  document.documentElement.style.setProperty('--soft',   t.soft);
