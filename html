/* 关卡结算 */
function finishLevel(gameId, level, score, passed) {
  const cfg = DEV_CONFIG[gameId];
  const total = cfg.levels.length;
  const lv = cfg.levels[level - 1];

  if (score > state.best[gameId]) state.best[gameId] = score;

  if (passed) {
    const curUnlock = state.level[gameId] || 1;
    const isNew = level >= curUnlock;
    const reward = isNew ? lv.reward : Math.floor(lv.reward / 2);

    addCoins(reward);

    if (level >= curUnlock) {
      state.level[gameId] = Math.min(total + 1, level + 1);
    }
    save();

    const nextUnlocked = state.level[gameId] > level && level < total;

    if (level < total) {
      showModal('🎉 第 ' + level + ' 关通过！',
        '<p>得分 <b>' + score + '</b>，获得 <b>' + reward + ' 🪙</b></p>' +
        (isNew ? '<p>第 ' + (level + 1) + ' 关已解锁！</p>' : '<p>重玩奖励减半，继续挑战下一关吧～</p>'),
        [
          { text: '返回房间', onClick: function () { closeModal(); backToRoom(); } },
          { text: nextUnlocked ? '下一关' : '重玩本关', primary: true,
            onClick: function () { closeModal(); startGame(gameId, nextUnlocked ? level + 1 : level); } }
        ]);
    } else {
      showModal('🏆 全部通关！',
        '<p>最后一关得分 <b>' + score + '</b>，获得 <b>' + reward + ' 🪙</b></p>' +
        '<p>三个小游戏都通关啦，可以随时回来重玩～</p>',
        [{ text: '返回房间', primary: true, onClick: function () { closeModal(); backToRoom(); } }]);
    }
  } else {
    save();
    showModal('😢 差一点点',
      '<p>得分 <b>' + score + '</b>' + (lv.target != null ? '，目标 ' + lv.target : '') + '</p>' +
      '<p>再来一次一定可以的！</p>',
      [
        { text: '返回房间', onClick: function () { closeModal(); backToRoom(); } },
        { text: '再试一次', primary: true, onClick: function () { closeModal(); startGame(gameId, level); } }
      ]);
  }
}

