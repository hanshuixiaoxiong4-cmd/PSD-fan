/* ---------------- 消消乐 ---------------- */
function startMatch3(level) {
  const cfg = DEV_CONFIG.match3;
  const lv = cfg.levels[level - 1];
  const R = 6, C = 6;

  $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · 目标 ' + lv.target + ' 分 · ' + lv.duration + ' 秒';
  makeGameBottom('match3', level);

  let run = true, busy = false, sel = null, score = 0, time = lv.duration, board = [];
  const cells = [];

  const grid = document.createElement('div'); grid.className = 'm3-grid'; $('gameArea').appendChild(grid);
  for (let r = 0; r < R; r++) {
    cells[r] = [];
    for (let c = 0; c < C; c++) {
      (function (rr, cc) {
        const d = document.createElement('div'); d.className = 'm3-cell';
        d.addEventListener('click', function () { click(rr, cc); });
        grid.appendChild(d); cells[rr][cc] = d;
      })(r, c);
    }
  }

  function rand() { return cfg.tiles[Math.floor(Math.random() * cfg.tiles.length)]; }
  function same(a, b) { return a && b && a.id === b.id; }
  function render() {
    for (let r = 0; r < R; r++) {
      for (let c = 0; c < C; c++) {
        const d = cells[r][c];
        clearEl(d);
        if (board[r][c]) d.appendChild(makeIcon(board[r][c]));
        d.classList.toggle('sel', !!sel && sel[0] === r && sel[1] === c);
      }
    }
  }

  function find() {
    const s = new Set();
    for (let r = 0; r < R; r++) {
      let n = 1;
      for (let c = 1; c <= C; c++) {
        const ok = c < C && same(board[r][c], board[r][c - 1]);
        if (ok) n++;
        else { if (n >= 3) for (let k = c - n; k < c; k++) s.add(r + ',' + k); n = 1; }
      }
    }
    for (let c = 0; c < C; c++) {
      let n = 1;
      for (let r = 1; r <= R; r++) {
        const ok = r < R && same(board[r][c], board[r - 1][c]);
        if (ok) n++;
        else { if (n >= 3) for (let k = r - n; k < r; k++) s.add(k + ',' + c); n = 1; }
      }
    }
    return s;
  }

  function sw(a, b, c, d) { const t = board[a][b]; board[a][b] = board[c][d]; board[c][d] = t; }

  function drop() {
    for (let c = 0; c < C; c++) {
      const rem = [];
      for (let r = R - 1; r >= 0; r--) if (board[r][c]) rem.push(board[r][c]);
      for (let r = R - 1, i = 0; r >= 0; r--, i++) board[r][c] = i < rem.length ? rem[i] : rand();
    }
  }

  function hasMove() {
    for (let r = 0; r < R; r++) {
      for (let c = 0; c < C; c++) {
        if (c + 1 < C) { sw(r, c, r, c + 1); const ok = find().size > 0; sw(r, c, r, c + 1); if (ok) return true; }
        if (r + 1 < R) { sw(r, c, r + 1, c); const ok = find().size > 0; sw(r, c, r + 1, c); if (ok) return true; }
      }
    }
    return false;
  }
  function init() {
    let guard = 0;
    do {
      board = [];
      for (let r = 0; r < R; r++) {
        board[r] = [];
        for (let c = 0; c < C; c++) board[r][c] = rand();
      }
      let m;
      while ((m = find()).size > 0 && guard++ < 60) {
        m.forEach(function (k) { const p = k.split(','); board[+p[0]][+p[1]] = rand(); });
      }
      guard++;
    } while (!hasMove() && guard < 80);
  }

  function resolve() {
    if (!run) return;
    const m = find();
    if (m.size === 0) { busy = false; return; }
    score += m.size * 10;
    $('gameScore').textContent = score;
    m.forEach(function (k) { const p = k.split(','); board[+p[0]][+p[1]] = null; });
    render();
    setTimeout(function () {
      if (!run) return;
      drop(); render();
      setTimeout(function () {
        if (!run) return;
        if (find().size === 0 && !hasMove()) init();
        resolve();
      }, 170);
    }, 170);
  }

  function click(r, c) {
    if (!run || busy) return;
    if (!sel) { sel = [r, c]; render(); return; }
    const sr = sel[0], sc = sel[1];
    if (sr === r && sc === c) { sel = null; render(); return; }
    if (Math.abs(sr - r) + Math.abs(sc - c) !== 1) { sel = [r, c]; render(); return; }
    sel = null; busy = true;
    sw(sr, sc, r, c); render();
    if (find().size === 0) {
      setTimeout(function () {
        if (!run) return;
        sw(sr, sc, r, c); render(); busy = false;
      }, 170);
    } else {
      setTimeout(resolve, 170);
    }
  }

  const timer = setInterval(function () {
    if (!run) return;
    time--;
    $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · 目标 ' + lv.target + ' 分 · 剩余 ' + Math.max(0, time) + ' 秒';
    if (time <= 0) end();
  }, 1000);

  function end() {
    run = false; clearInterval(timer);
    const m = find();
    if (m.size > 0) score += m.size * 10;
    finishLevel('match3', level, score, score >= lv.target);
  }

  init(); render();
  activeCleanup = function () { run = false; clearInterval(timer); };
}

/* ---------------- 打地鼠 ---------------- */
function startWhack(level) {
  const cfg = DEV_CONFIG.whack;
  const lv = cfg.levels[level - 1];
  const HOLES = 9;

  $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · 目标 ' + lv.target + ' 分 · ' + lv.duration + ' 秒';
  makeGameBottom('whack', level);

  let run = true, score = 0, time = lv.duration;
  const timers = []; let spawnT = null;

  const board = document.createElement('div'); board.className = 'whack-board'; $('gameArea').appendChild(board);
  const holes = [];

  for (let i = 0; i < HOLES; i++) {
    (function () {
      const d = document.createElement('div'); d.className = 'whack-hole';
      d.dataset.on = '0'; d.dataset.val = '0';
      d.addEventListener('click', function () {
        if (!run || d.dataset.on !== '1') return;
        score += parseInt(d.dataset.val, 10) || 0;
        $('gameScore').textContent = score;
        d.dataset.on = '0'; d.dataset.val = '0';
        clearEl(d); d.classList.remove('on');
      });
      board.appendChild(d); holes.push(d);
    })();
  }
  function spawn() {
    if (!run) return;
    const free = holes.filter(function (h) { return h.dataset.on === '0'; });
    if (!free.length) return;
    const h = free[Math.floor(Math.random() * free.length)];
    const bad = Math.random() < lv.badRate;
    const pool = bad ? cfg.bad : cfg.good;
    const it = pool[Math.floor(Math.random() * pool.length)];
    clearEl(h); h.appendChild(makeIcon(it));
    h.dataset.on = '1'; h.dataset.val = String(it.score);
    h.classList.add('on');
    timers.push(setTimeout(function () {
      if (h.dataset.on === '1') {
        h.dataset.on = '0'; h.dataset.val = '0';
        clearEl(h); h.classList.remove('on');
      }
    }, 680));
  }

  function loop() {
    if (!run) return;
    spawn();
    spawnT = setTimeout(loop, lv.interval + Math.random() * 300);
  }

  const timer = setInterval(function () {
    if (!run) return;
    time--;
    $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · 目标 ' + lv.target + ' 分 · 剩余 ' + Math.max(0, time) + ' 秒';
    if (time <= 0) end();
  }, 1000);

  function end() {
    run = false; clearInterval(timer); clearTimeout(spawnT);
    timers.forEach(clearTimeout);
    finishLevel('whack', level, score, score >= lv.target);
  }

  loop();
  activeCleanup = function () {
    run = false; clearInterval(timer); clearTimeout(spawnT);
    timers.forEach(clearTimeout);
  };
}

/* ---------------- 记忆配对 ---------------- */
function startMemory(level) {
  const cfg = DEV_CONFIG.memory;
  const lv = cfg.levels[level - 1];

  $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · ' + lv.pairs + ' 对 · ' + lv.duration + ' 秒';
  makeGameBottom('memory', level);

  let run = true, time = lv.duration, moves = 0, matched = 0, first = null, lock = false;

  const picked = cfg.cards.slice(0, lv.pairs);
  const deck = shuffle(picked.concat(picked));
  const grid = document.createElement('div'); grid.className = 'mem-grid'; $('gameArea').appendChild(grid);

  for (let i = 0; i < deck.length; i++) {
    (function (idx) {
      const d = document.createElement('div'); d.className = 'mem-card';
      showBack(d);
      d.addEventListener('click', function () { click(idx, d); });
      grid.appendChild(d);
    })(i);
  }

  function showBack(el) { clearEl(el); el.appendChild(makeIcon(cfg.back)); el.classList.remove('flip', 'matched'); }
  function showFront(el, data) { clearEl(el); el.appendChild(makeIcon(data)); el.classList.add('flip'); }

  function click(idx, el) {
    if (!run || lock || el.classList.contains('matched')) return;
    if (first && first.idx === idx) return;
    showFront(el, deck[idx]);
    if (!first) { first = { idx: idx, el: el }; return; }
    moves++; lock = true;
    const a = first; first = null;

    if (deck[a.idx].emoji === deck[idx].emoji) {
      setTimeout(function () {
        if (!run) return;
        a.el.classList.add('matched'); el.classList.add('matched');
        matched++; lock = false;
        if (matched === lv.pairs) end();
      }, 240);
    } else {
      setTimeout(function () {
        if (!run) return;
        showBack(a.el); showBack(el); lock = false;
      }, 650);
    }
  }

  const timer = setInterval(function () {
    if (!run) return;
    time--;
    $('gameInfo').textContent = '第 ' + level + '/' + cfg.levels.length + ' 关 · 已配对 ' + matched + ' · 剩余 ' + Math.max(0, time) + ' 秒';
    if (time <= 0) {
      run = false; clearInterval(timer);
      finishLevel('memory', level, matched * 10, false);
    }
  }, 1000);

  function end() {
    run = false; clearInterval(timer);
    const sc = Math.max(20, lv.pairs * 100 - moves * 8);
    $('gameScore').textContent = sc;
    finishLevel('memory', level, sc, true);
  }

  activeCleanup = function () { run = false; clearInterval(timer); };
}
