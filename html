  const t = document.createElement('div');
  t.textContent = msg;
  t.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:#fff;padding:10px 20px;border-radius:20px;font-size:13px;font-weight:700;z-index:2000;box-shadow:0 8px 24px rgba(0,0,0,.15);max-width:90%;text-align:center;';
  document.body.appendChild(t);
  setTimeout(function () { t.remove(); }, 1800);
}

/* 改名 */
$('btnRename').addEventListener('click', function () {
  let html = '';
  Object.values(DEV_CONFIG.characters).forEach(function (ch) {
    html += '<div class="field"><label>' + esc(ch.name) + ' 的名字</label>' +
      '<input id="inp-' + ch.key + '" maxlength="8" value="' + esc(state.names[ch.key] || '') + '"></div>';
  });
  showModal('✏️ 取名字', html, [
    { text: '取消', onClick: closeModal },
    { text: '保存', primary: true, onClick: function () {
      Object.values(DEV_CONFIG.characters).forEach(function (ch) {
        const el = $('inp-' + ch.key);
        const v = el ? el.value : '';
        state.names[ch.key] = v.trim() || ch.name;
      });
      save(); refreshHUD(); closeModal();
    } }
  ]);
});

/* 装扮商店 */
$('btnDress').addEventListener('click', function () {
  let html = '<p style="font-size:12px;color:var(--muted);margin-bottom:12px;">🪙 金币：' + state.coins + '</p>';

  html += '<div class="opt-row"><span class="opt-label">主题</span><div style="display:flex;gap:6px;flex-wrap:wrap;">';
  DEV_CONFIG.shop.themes.forEach(function (t) {
    const owned = state.ownedThemes.indexOf(t.id) !== -1;
    const on = state.theme === t.id;
    html += '<button class="opt' + (on ? ' on' : '') + (owned ? '' : ' locked') + '" ' +
      'data-theme="' + t.id + '" ' + (owned ? '' : 'disabled') + ' ' +
      'style="background:' + t.bg + '" title="' + esc(t.name) + (owned ? '' : ' · ' + t.price + '🪙') + '">' +
      (owned ? '' : '🔒') + '</button>';
  });
  html += '</div></div>';

  Object.values(DEV_CONFIG.characters).forEach(function (ch) {
    html += '<div class="opt-row"><span class="opt-label">' + esc(state.names[ch.key]) + '</span><div style="display:flex;gap:5px;flex-wrap:wrap;">';
    DEV_CONFIG.shop.accessories.forEach(function (a) {
      const owned = state.ownedAcc.indexOf(a.id) !== -1;
      const on = state.acc[ch.key] === a.id;
      html += '<button class="opt' + (on ? ' on' : '') + (owned ? '' : ' locked') + '" ' +
         'data-acc="' + ch.key + '" data-val="' + a.id + '" ' + (owned ? '' : 'disabled') + '>' +
        (owned ? a.emoji : '🔒') + '</button>';
    });
    html += '</div></div>';
  });

  showModal('🎀 装扮商店', html, [{ text: '关闭', onClick: closeModal }]);

  $('modalBody').querySelectorAll('[data-theme]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const id = btn.dataset.theme;
      const t = DEV_CONFIG.shop.themes.find(function (x) { return x.id === id; });
      if (state.ownedThemes.indexOf(id) === -1) {
        if (state.coins < t.price) { showToast('金币不够哦～'); return; }
        state.coins -= t.price; state.ownedThemes.push(id); addCoins(0);
      }
      state.theme = id; save(); applyTheme(); refreshHUD(); closeModal();
    });
  });

  $('modalBody').querySelectorAll('[data-acc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const key = btn.dataset.acc;
      const id = btn.dataset.val;
      const a = DEV_CONFIG.shop.accessories.find(function (x) { return x.id === id; });
      if (state.ownedAcc.indexOf(id) === -1) {
        if (state.coins < a.price) { showToast('金币不够哦～'); return; }
        state.coins -= a.price; state.ownedAcc.push(id); addCoins(0);
      }
      state.acc[key] = id; save(); refreshHUD(); closeModal();
    });
  });
});

/* 教程 */
const TUT = [
  { sel: '.map-grid', text: '这是你们的家～点一点房间就能进去互动。小游戏都放在「游戏室」里，一共 3 个游戏，每个 15 关。' },
  { sel: '.family-strip', text: '一家人各自有心情值。在房间里点击他们，可以提升心情、赚金币；金币能用来买配饰和主题。' },
  { sel: '.top-actions', text: '右上角可以取名字、装扮、重看教程。小游戏通关也会奖励金币，重玩已通关的关卡奖励减半。' }
];
let tutI = 0;

function startTut() { tutI = 0; $('tutMask').classList.add('show'); renderTut(); }

function renderTut() {
  if (tutI >= TUT.length) {
    $('tutMask').classList.remove('show');
    state.tutorialDone = true; save(); return;
  }
  const st = TUT[tutI];
  const t = document.querySelector(st.sel);
  if (!t) { tutI++; renderTut(); return; }
  const r = t.getBoundingClientRect();
  const h = $('tutHole');
  h.style.cssText = 'left:' + (r.left - 8) + 'px;top:' + (r.top - 8) + 'px;width:' + (r.width + 16) + 'px;height:' + (r.height + 16) + 'px;';
  $('tutText').textContent = st.text;
  $('tutNext').textContent = tutI === TUT.length - 1 ? '开始吧！' : '下一步';
}

$('tutNext').addEventListener('click', function () { tutI++; renderTut(); });
$('tutSkip').addEventListener('click', function () {
  $('tutMask').classList.remove('show');
  state.tutorialDone = true; save();
});
$('btnTut').addEventListener('click', startTut);

/* ---------------- 初始化 ---------------- */
load();
applyTheme();
renderMap();
refreshHUD();
if (!state.tutorialDone) setTimeout(startTut, 400);
</script>
